{
  "name": "doctor-demo",
  "version": "1.0.0",
  "description": "Clinic Care Doctor Web Application in React",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:hosting": "node scripts/require-hosting-profile.mjs && vite build && node scripts/build-hosting.mjs",
    "prepare:hosting": "node appointment-system/tools/install/source.mjs",
    "test": "node --test scripts/tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=\"scripts/tests/**\" --test-coverage-exclude=\"appointment-system/**\" scripts/tests/*.test.mjs",
    "preview:built": "node scripts/dev-preview.mjs",
    "smoke": "node scripts/smoke/pages.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@pdf-lib/fontkit": "1.1.1",
    "@vercel/functions": "3.10.1",
    "pdf-lib": "1.17.1",
    "react": "^19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0"
  }
}
